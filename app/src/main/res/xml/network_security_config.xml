<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Percayai sertifikat sistem DAN sertifikat yang dipasang pengguna
         (mis. sertifikat AdGuard), seperti perilaku Chrome. -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
